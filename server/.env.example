# ──────────────────────────────────────────────────────────────────────────────
# SERVER ENVIRONMENT VARIABLES  (.env.example — commit this, NOT .env)
# Copy this file to .env and fill in your real values before running locally.
# On Vercel: add these under Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# Port (Vercel ignores this — only needed for local dev)
PORT=5000

# MongoDB Atlas connection string
# ⚠️  IMPORTANT: Vercel uses dynamic IPs. In MongoDB Atlas → Network Access,
#     add 0.0.0.0/0 (Allow Access from Anywhere) so serverless functions can connect.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_string

# Client URL — CORS origin whitelist
# Supports comma-separated values for multiple origins:
# CLIENT_URL=https://your-client.vercel.app,https://custom-domain.com
# Local dev:
CLIENT_URL=http://localhost:5173
# Production (Vercel automatically allows *.vercel.app — but add your custom domain here):
# CLIENT_URL=https://your-client-project.vercel.app,https://www.srisairamconsultancy.com,https://srisairamconsultancy.com

